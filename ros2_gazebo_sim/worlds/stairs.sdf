<?xml version="1.0"?>
<!-- Staircase: flat lead-in, 5 steps (riser 0.03, tread 0.20) from x=1.5,
     then a plateau at z=0.15. -->
<sdf version="1.9">
  <world name="biped_stairs">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.55 0.58 0.62 1</ambient><background>0.22 0.27 0.30 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 8 0 0 0</pose><diffuse>0.85 0.85 0.82 1</diffuse><direction>-0.35 0.2 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="ground_link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 20</size></plane></geometry><material><ambient>0.30 0.34 0.36 1</ambient><diffuse>0.30 0.34 0.36 1</diffuse></material></visual></link></model>
    <model name="step1"><static>true</static><pose>4.75 0 -0.070 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>6.50 1.6 0.200</size></box></geometry></collision><visual name="v"><geometry><box><size>6.50 1.6 0.200</size></box></geometry><material><diffuse>0.45 0.50 0.51 1</diffuse></material></visual></link></model>
    <model name="step2"><static>true</static><pose>4.85 0 -0.040 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>6.30 1.6 0.200</size></box></geometry></collision><visual name="v"><geometry><box><size>6.30 1.6 0.200</size></box></geometry><material><diffuse>0.46 0.51 0.52 1</diffuse></material></visual></link></model>
    <model name="step3"><static>true</static><pose>4.95 0 -0.010 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>6.10 1.6 0.200</size></box></geometry></collision><visual name="v"><geometry><box><size>6.10 1.6 0.200</size></box></geometry><material><diffuse>0.47 0.52 0.53 1</diffuse></material></visual></link></model>
    <model name="step4"><static>true</static><pose>5.05 0 0.020 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>5.90 1.6 0.200</size></box></geometry></collision><visual name="v"><geometry><box><size>5.90 1.6 0.200</size></box></geometry><material><diffuse>0.48 0.53 0.54 1</diffuse></material></visual></link></model>
    <model name="step5"><static>true</static><pose>5.15 0 0.050 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>5.70 1.6 0.200</size></box></geometry></collision><visual name="v"><geometry><box><size>5.70 1.6 0.200</size></box></geometry><material><diffuse>0.49 0.54 0.55 1</diffuse></material></visual></link></model>
  </world>
</sdf>
