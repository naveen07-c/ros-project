<?xml version="1.0"?>
<!--
  Biped robot for Gazebo Harmonic + ros2_control.

  Conventions: +x = forward, +y = left, +z = up.
  Joint axes: pitch (fore/aft) rotates about y, roll (sideways) rotates about x.

  Kinematic chain per leg:
    base_link -> (hip_roll) -> hip_link -> (hip_pitch) -> thigh
              -> (knee_pitch) -> shin     -> (ankle_pitch) -> ankle_link
              -> (ankle_roll) -> foot

  This is a proper tree (no loops, each link has exactly one parent joint).
-->
<robot name="biped_robot">

  <material name="light_gray"><color rgba="0.90 0.90 0.90 1"/></material>
  <material name="dark_gray"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="accent"><color rgba="0.85 0.35 0.15 1"/></material>
  <material name="payload_blue"><color rgba="0.15 0.45 0.85 1"/></material>

  <!-- ============================ PELVIS ============================ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.0205" ixy="0" ixz="0" iyy="0.0109" iyz="0" izz="0.0296"/>
    </inertial>
    <collision name="base_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.20 0.28 0.06"/></geometry>
    </collision>
    <visual name="base_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.20 0.28 0.06"/></geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <!-- ====================== PAYLOAD (1 kg on top) ==================== -->
  <!-- Extra mass carried on top of the pelvis. Its mass and position are
       mirrored by the balance controller (payload_mass/payload_x/y/z) so the
       ZMP/LIPM plan and the CoM offsets account for it. -->
  <link name="payload">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000967" ixy="0" ixz="0" iyy="0.000967" iyz="0" izz="0.001667"/>
    </inertial>
    <collision name="payload_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.04"/></geometry>
    </collision>
    <visual name="payload_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.04"/></geometry>
      <material name="payload_blue"/>
    </visual>
  </link>

  <joint name="payload_joint" type="fixed">
    <parent link="base_link"/>
    <child link="payload"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ========================== LEFT LEG =========================== -->
  <link name="left_hip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00006"/>
    </inertial>
    <collision name="left_hip_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.06"/></geometry>
    </collision>
    <visual name="left_hip_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.06"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="left_hip_roll" type="revolute">
    <parent link="base_link"/>
    <child link="left_hip_link"/>
    <origin xyz="0 0.085 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.6" effort="60" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00624" ixy="0" ixz="0" iyy="0.00624" iyz="0" izz="0.00048"/>
    </inertial>
    <collision name="left_thigh_collision">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
    </collision>
    <visual name="left_thigh_visual">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_link"/>
    <child link="left_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="80" velocity="5.0"/>
    <dynamics damping="1.5" friction="0.0"/>
  </joint>

  <link name="left_shin">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00308" ixy="0" ixz="0" iyy="0.00308" iyz="0" izz="0.00017"/>
    </inertial>
    <collision name="left_shin_collision">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
    </collision>
    <visual name="left_shin_visual">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <joint name="left_knee_pitch" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.05" upper="1.8" effort="80" velocity="5.0"/>
    <dynamics damping="1.5" friction="0.0"/>
  </joint>

  <link name="left_ankle_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000013" ixy="0" ixz="0" iyy="0.000013" iyz="0" izz="0.000013"/>
    </inertial>
    <collision name="left_ankle_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
    <visual name="left_ankle_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_shin"/>
    <child link="left_ankle_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="40" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <link name="left_foot">
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00024" ixy="0" ixz="0" iyy="0.00085" iyz="0" izz="0.00101"/>
    </inertial>
    <collision name="left_foot_collision">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.18 0.10 0.04"/></geometry>
    </collision>
    <visual name="left_foot_visual">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.18 0.10 0.04"/></geometry>
      <material name="accent"/>
    </visual>
  </link>

  <joint name="left_ankle_roll" type="revolute">
    <parent link="left_ankle_link"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="40" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- ========================== RIGHT LEG ========================== -->
  <link name="right_hip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00006"/>
    </inertial>
    <collision name="right_hip_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.06"/></geometry>
    </collision>
    <visual name="right_hip_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.06"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="right_hip_roll" type="revolute">
    <parent link="base_link"/>
    <child link="right_hip_link"/>
    <origin xyz="0 -0.085 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.6" effort="60" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <link name="right_thigh">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00624" ixy="0" ixz="0" iyy="0.00624" iyz="0" izz="0.00048"/>
    </inertial>
    <collision name="right_thigh_collision">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
    </collision>
    <visual name="right_thigh_visual">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_link"/>
    <child link="right_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="80" velocity="5.0"/>
    <dynamics damping="1.5" friction="0.0"/>
  </joint>

  <link name="right_shin">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00308" ixy="0" ixz="0" iyy="0.00308" iyz="0" izz="0.00017"/>
    </inertial>
    <collision name="right_shin_collision">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
    </collision>
    <visual name="right_shin_visual">
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <joint name="right_knee_pitch" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.05" upper="1.8" effort="80" velocity="5.0"/>
    <dynamics damping="1.5" friction="0.0"/>
  </joint>

  <link name="right_ankle_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000013" ixy="0" ixz="0" iyy="0.000013" iyz="0" izz="0.000013"/>
    </inertial>
    <collision name="right_ankle_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
    <visual name="right_ankle_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_ankle_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="40" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <link name="right_foot">
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00024" ixy="0" ixz="0" iyy="0.00085" iyz="0" izz="0.00101"/>
    </inertial>
    <collision name="right_foot_collision">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.18 0.10 0.04"/></geometry>
    </collision>
    <visual name="right_foot_visual">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.18 0.10 0.04"/></geometry>
      <material name="accent"/>
    </visual>
  </link>

  <joint name="right_ankle_roll" type="revolute">
    <parent link="right_ankle_link"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="40" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- ===================== ros2_control (Gazebo) ===================== -->
  <ros2_control name="BipedGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_hip_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_hip_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_hip_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_hip_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_knee_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_knee_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_ankle_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_ankle_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_ankle_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_ankle_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- High friction on the feet so the robot does not slip while walking. -->
  <gazebo reference="left_foot">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>10000000.0</kp>
    <kd>1000.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>
  <gazebo reference="right_foot">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>10000000.0</kp>
    <kd>1000.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <!-- gz_ros2_control plugin: hosts the controller_manager inside Gazebo. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>@CONTROLLER_CONFIG@</parameters>
    </plugin>
  </gazebo>

  <!-- Publishes the base pose/velocity so the balance controller can keep
       the robot upright while walking. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
