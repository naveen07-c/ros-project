<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alderbrook Academy — School Management System</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#EFF2E9; --surface:#FFFFFF; --ink:#152219; --ink2:#5C6B5F;
  --pine:#123B2A; --pine2:#1C5A3F; --pine3:#0C2A1E;
  --moss:#DDE7D8; --line:#D9E0D2; --line2:#C6D0C0;
  --amber:#F2A93B; --amber-d:#B97A10; --amber-s:#FCEBCB;
  --clay:#C4502F; --clay-s:#F8E3DB; --sky:#2F6FA3; --sky-s:#DFEBF5;
  --disp:'Bricolage Grotesque',sans-serif; --body:'Public Sans',sans-serif;
  --mono:'IBM Plex Mono',monospace; --chalk:'Caveat',cursive;
  --sh:0 1px 2px rgba(21,34,25,.05),0 4px 14px rgba(21,34,25,.05);
  --sh2:0 8px 30px rgba(12,42,30,.16);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:var(--body);color:var(--ink);font-size:14px;line-height:1.5;
  background:
    radial-gradient(1100px 520px at 88% -8%, rgba(242,169,59,.12), transparent 60%),
    radial-gradient(900px 520px at -8% 108%, rgba(18,59,42,.09), transparent 60%),
    linear-gradient(rgba(18,59,42,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(18,59,42,.045) 1px, transparent 1px),
    var(--paper);
  background-size:auto,auto,28px 28px,28px 28px,auto;
  background-attachment:fixed;
}
::selection{background:var(--amber);color:var(--pine3)}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:14px;color:var(--ink)}
h1,h2,h3,.disp{font-family:var(--disp)}
.mono{font-family:var(--mono)}
.chalk{font-family:var(--chalk)}

/* ---------- LOGIN ---------- */
#login{min-height:100vh;display:grid;grid-template-columns:1.15fr 1fr}
.board{
  position:relative;overflow:hidden;color:#EDF3EA;padding:56px 64px;display:flex;flex-direction:column;
  background:
    radial-gradient(700px 340px at 20% 0%, rgba(255,255,255,.05), transparent 60%),
    radial-gradient(rgba(255,255,255,.035) 1px, transparent 1.4px),
    linear-gradient(160deg,#123527,#0C2A1E 55%,#0A2318);
  background-size:auto,26px 26px,auto;
  border-right:10px solid #B98A3E;
  box-shadow:inset 0 0 120px rgba(0,0,0,.35);
}
.board::after{content:"";position:absolute;left:0;right:0;bottom:0;height:14px;background:linear-gradient(#8a6a35,#6d5127);box-shadow:0 -2px 0 rgba(255,255,255,.15)}
.crest{width:74px;height:84px;flex:none}
.brandrow{display:flex;align-items:center;gap:18px}
.schoolname{font-family:var(--disp);font-weight:800;font-size:clamp(30px,3.4vw,44px);letter-spacing:-.5px;line-height:1.05}
.schoolsub{font-family:var(--mono);font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:#B9CDB9;margin-top:8px}
.motto{font-family:var(--chalk);font-size:26px;color:var(--amber);transform:rotate(-1.5deg);margin:26px 0 4px}
.chalknote{position:absolute;font-family:var(--chalk);color:rgba(237,243,234,.85);font-size:22px;transform:rotate(-2deg)}
.chalknote b{color:var(--amber)}
.cn1{right:70px;top:120px}.cn2{right:120px;top:330px;transform:rotate(1.6deg)}
.bells{margin-top:auto;border:1.5px dashed rgba(237,243,234,.35);border-radius:10px;padding:18px 22px;max-width:380px}
.bells h4{font-family:var(--mono);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#9FB8A0;margin-bottom:10px}
.bells li{list-style:none;display:flex;justify-content:space-between;gap:20px;padding:4px 0;font-size:13px;color:#DCE8DA;border-bottom:1px dotted rgba(237,243,234,.15)}
.bells li:last-child{border:0}
.bells .mono{color:var(--amber)}
.boardtick{position:absolute;bottom:26px;left:64px;right:64px;overflow:hidden;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#CFE0CC}
.login-side{display:flex;align-items:center;justify-content:center;padding:48px 28px}
.login-card{width:min(430px,100%);background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--sh2);padding:34px 34px 28px;animation:pop .5s cubic-bezier(.2,.9,.3,1.2) both}
.login-card .tag{font-family:var(--mono);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--amber-d)}
.login-card h2{font-size:28px;font-weight:800;letter-spacing:-.4px;margin:6px 0 4px}
.login-card p.sub{color:var(--ink2);font-size:13px;margin-bottom:22px}
.fld{margin-bottom:14px}
.fld label{display:block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2);margin-bottom:6px}
.fld input,.fld select,.fld textarea{width:100%;padding:10px 12px;border:1.5px solid var(--line2);border-radius:8px;background:#FBFCF9;outline:none;transition:border .2s, box-shadow .2s}
.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--amber);box-shadow:0 0 0 3px rgba(242,169,59,.22)}
.btn{display:inline-flex;align-items:center;gap:8px;border:none;border-radius:8px;padding:10px 16px;font-weight:700;font-size:13px;transition:transform .12s, box-shadow .2s, background .2s;letter-spacing:.01em}
.btn:active{transform:translateY(1px) scale(.99)}
.btn-pine{background:var(--pine);color:#fff;box-shadow:0 2px 0 var(--pine3)}
.btn-pine:hover{background:var(--pine2);box-shadow:0 4px 14px rgba(18,59,42,.35);transform:translateY(-1px)}
.btn-amber{background:var(--amber);color:var(--pine3);box-shadow:0 2px 0 var(--amber-d)}
.btn-amber:hover{transform:translateY(-1px);box-shadow:0 5px 16px rgba(242,169,59,.5)}
.btn-ghost{background:transparent;border:1.5px solid var(--line2);color:var(--ink)}
.btn-ghost:hover{border-color:var(--pine);color:var(--pine);background:#F3F7F1}
.btn-danger{background:var(--clay);color:#fff}
.btn-sm{padding:6px 11px;font-size:12px;border-radius:7px}
.btn-block{width:100%;justify-content:center}
.divider{display:flex;align-items:center;gap:12px;color:var(--ink2);font-size:11px;letter-spacing:.2em;text-transform:uppercase;margin:18px 0 14px}
.divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--line)}
.rolebtn{display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:#FBFCF9;border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:9px;transition:all .18s}
.rolebtn:hover{border-color:var(--pine);transform:translateX(4px);background:#F2F7F0;box-shadow:var(--sh)}
.rolebtn .ric{width:38px;height:38px;border-radius:9px;display:grid;place-items:center;color:#fff;flex:none}
.rolebtn b{display:block;font-size:13.5px}
.rolebtn span{font-size:11.5px;color:var(--ink2)}
.rolebtn .arr{margin-left:auto;color:var(--line2);transition:all .18s}
.rolebtn:hover .arr{color:var(--pine);transform:translateX(3px)}

/* ---------- APP SHELL ---------- */
#app{display:none;grid-template-columns:266px 1fr;height:100vh}
#app.on{display:grid;animation:fade .4s both}
aside{
  background:linear-gradient(180deg,#123527,#0C2A1E);color:#D7E4D3;display:flex;flex-direction:column;
  border-right:1px solid rgba(255,255,255,.06);overflow-y:auto;
  background-image:radial-gradient(rgba(255,255,255,.035) 1px, transparent 1.3px),linear-gradient(180deg,#123527,#0C2A1E);
  background-size:24px 24px,auto;
}
aside::-webkit-scrollbar{width:6px}aside::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:3px}
.side-head{display:flex;gap:12px;align-items:center;padding:22px 20px 18px;border-bottom:1px solid rgba(255,255,255,.08)}
.side-head .crest{width:40px;height:46px}
.side-head b{font-family:var(--disp);font-size:16.5px;color:#fff;letter-spacing:-.2px;display:block;line-height:1.15}
.side-head span{font-family:var(--mono);font-size:9px;letter-spacing:.28em;text-transform:uppercase;color:#8FA98F}
.navgroup{padding:16px 12px 4px}
.navgroup h5{font-family:var(--mono);font-size:9px;letter-spacing:.3em;text-transform:uppercase;color:#7C967C;padding:0 10px 8px}
.navitem{display:flex;align-items:center;gap:11px;width:100%;padding:9px 12px;border-radius:8px;color:#C3D4C0;font-size:13px;font-weight:500;background:none;border:none;border-left:3px solid transparent;transition:all .16s;text-align:left;margin-bottom:2px}
.navitem:hover{background:rgba(255,255,255,.07);color:#fff;transform:translateX(2px)}
.navitem.act{background:rgba(242,169,59,.13);border-left-color:var(--amber);color:#fff}
.navitem.act svg{color:var(--amber)}
.navitem .cnt{margin-left:auto;font-family:var(--mono);font-size:10px;background:rgba(255,255,255,.12);padding:1px 7px;border-radius:20px}
.navitem.act .cnt{background:var(--amber);color:var(--pine3);font-weight:600}
.side-foot{margin-top:auto;padding:16px;border-top:1px solid rgba(255,255,255,.08)}
.termchip{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:#9FB8A0;background:rgba(255,255,255,.06);border:1px dashed rgba(255,255,255,.2);border-radius:7px;padding:7px 10px;margin-bottom:12px;text-align:center}
main{overflow-y:auto;height:100vh;position:relative}
main::-webkit-scrollbar{width:10px}main::-webkit-scrollbar-thumb{background:var(--line2);border-radius:6px;border:3px solid var(--paper)}

/* topbar */
.topbar{position:sticky;top:0;z-index:40;background:rgba(239,242,233,.92);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:16px;padding:14px 28px}
.topbar .crumb{font-family:var(--mono);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--ink2)}
.topbar h1{font-size:24px;font-weight:800;letter-spacing:-.5px;line-height:1.1}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:12px}
.searchbox{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--line2);border-radius:9px;padding:8px 12px;min-width:230px;transition:all .2s}
.searchbox:focus-within{border-color:var(--amber);box-shadow:0 0 0 3px rgba(242,169,59,.2)}
.searchbox input{border:none;outline:none;background:none;width:100%;font-size:13px}
.clock{font-family:var(--mono);font-size:12.5px;font-weight:600;color:var(--pine);background:#fff;border:1.5px solid var(--line);border-radius:9px;padding:8px 12px;display:flex;gap:8px;align-items:center}
.clock .pulse{width:7px;height:7px;border-radius:50%;background:#2FA36B;animation:pulse 1.8s infinite}
.iconbtn{position:relative;width:40px;height:40px;border-radius:9px;border:1.5px solid var(--line2);background:#fff;display:grid;place-items:center;color:var(--ink2);transition:all .18s}
.iconbtn:hover{color:var(--pine);border-color:var(--pine);transform:translateY(-1px);box-shadow:var(--sh)}
.iconbtn .badge{position:absolute;top:-5px;right:-5px;background:var(--clay);color:#fff;font-family:var(--mono);font-size:9.5px;font-weight:600;min-width:17px;height:17px;border-radius:9px;display:grid;place-items:center;border:2px solid var(--paper)}
.userchip{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--line2);border-radius:9px;padding:5px 10px 5px 5px;transition:all .18s}
.userchip:hover{border-color:var(--pine);box-shadow:var(--sh)}
.avatar{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;color:#fff;font-weight:700;font-size:12px;font-family:var(--disp);flex:none}
.av-lg{width:52px;height:52px;font-size:18px;border-radius:12px}
.userchip .uinfo b{display:block;font-size:12.5px;line-height:1.2}
.userchip .uinfo span{font-size:10.5px;color:var(--ink2)}
.dropdown{position:absolute;right:0;top:calc(100% + 8px);background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--sh2);min-width:300px;padding:8px;animation:pop .22s cubic-bezier(.2,.9,.3,1.15) both;z-index:60}
.dropdown .dhead{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-bottom:1px solid var(--line);margin-bottom:6px}
.dropdown .dhead b{font-size:13px}
.noti{display:flex;gap:10px;padding:9px 10px;border-radius:8px;transition:background .15s;cursor:pointer}
.noti:hover{background:#F3F7F1}
.noti.unread{background:#FBF4E4}.noti.unread:hover{background:#F7EDD6}
.noti .ndot{width:8px;height:8px;border-radius:50%;background:var(--amber);margin-top:6px;flex:none}
.noti p{font-size:12.5px;line-height:1.35}.noti time{font-family:var(--mono);font-size:10px;color:var(--ink2)}
.menuitem{display:flex;align-items:center;gap:10px;width:100%;padding:9px 10px;border:none;background:none;border-radius:8px;font-size:13px;font-weight:600;color:var(--ink);transition:background .15s;text-align:left}
.menuitem:hover{background:#F3F7F1}
.menuitem.danger{color:var(--clay)}

/* content */
.content{padding:26px 28px 60px;max-width:1440px;margin:0 auto}
.ticker{background:linear-gradient(90deg,#F6B54C,#F2A93B);border:1px solid #E19A22;border-radius:10px;overflow:hidden;margin-bottom:22px;box-shadow:var(--sh);position:relative}
.ticker::before{content:"NOTICE BOARD";position:absolute;left:0;top:0;bottom:0;background:var(--pine);color:var(--amber);font-family:var(--mono);font-size:9.5px;letter-spacing:.22em;display:flex;align-items:center;padding:0 12px;z-index:2}
.ticker-track{display:inline-flex;white-space:nowrap;padding:9px 0;animation:marq 38s linear infinite;font-family:var(--mono);font-size:12px;font-weight:600;color:var(--pine3)}
.ticker:hover .ticker-track{animation-play-state:paused}
.ticker-track span{padding:0 26px}
.grid{display:grid;gap:18px}
.g12{grid-template-columns:repeat(12,1fr)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:var(--sh)}
.card-h{display:flex;align-items:center;gap:10px;padding:16px 20px;border-bottom:1px solid var(--line)}
.card-h h3{font-size:15.5px;font-weight:700;letter-spacing:-.2px}
.card-h .sub{font-size:11.5px;color:var(--ink2)}
.card-b{padding:18px 20px}
.span3{grid-column:span 3}.span4{grid-column:span 4}.span5{grid-column:span 5}
.span6{grid-column:span 6}.span7{grid-column:span 7}.span8{grid-column:span 8}.span12{grid-column:span 12}

/* stat cards */
.stat{position:relative;overflow:hidden;padding:18px 20px 14px;transition:transform .2s, box-shadow .2s}
.stat:hover{transform:translateY(-3px);box-shadow:var(--sh2)}
.stat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--sc,var(--pine))}
.stat .lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink2)}
.stat .num{font-family:var(--disp);font-size:36px;font-weight:800;letter-spacing:-1px;line-height:1.15;margin:4px 0 2px;font-variant-numeric:tabular-nums}
.stat .delta{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px}
.d-up{background:#E2F1E6;color:#1D7A45}.d-dn{background:var(--clay-s);color:var(--clay)}.d-fl{background:#EDEFEA;color:var(--ink2)}
.stat .spark{position:absolute;right:14px;bottom:12px;opacity:.9}
.stat .wm{position:absolute;right:12px;top:10px;color:var(--sc,var(--pine));opacity:.16}

/* charts */
.cbar{transform-box:fill-box;transform-origin:bottom;animation:growY .7s cubic-bezier(.2,.8,.3,1) both}
.cbar:hover{filter:brightness(1.15)}
.area-line{stroke-dasharray:1400;stroke-dashoffset:1400;animation:draw 1.6s ease forwards}
.ring-fg{animation:ringA 1.2s cubic-bezier(.3,.8,.3,1) both}
.hb{background:#EDEFEA;border-radius:6px;height:12px;overflow:hidden;flex:1}
.hb i{display:block;height:100%;border-radius:6px;width:var(--w);animation:growW .9s cubic-bezier(.2,.8,.3,1) both}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:11.5px;color:var(--ink2)}
.legend i{width:10px;height:10px;border-radius:3px;display:inline-block;margin-right:6px;vertical-align:-1px}

/* tables */
.tbl{width:100%;border-collapse:collapse}
.tbl th{font-family:var(--mono);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink2);text-align:left;padding:11px 14px;border-bottom:1.5px solid var(--line);background:#FAFBF7;white-space:nowrap}
.tbl td{padding:11px 14px;border-bottom:1px solid var(--line);font-size:13px;vertical-align:middle}
.tbl tbody tr{transition:background .14s, box-shadow .14s}
.tbl tbody tr:hover{background:#F5F8F2;box-shadow:inset 3px 0 0 var(--amber)}
.tbl tbody tr:last-child td{border-bottom:none}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap}
.pill i{width:6px;height:6px;border-radius:50%;background:currentColor}
.p-green{background:#E2F1E6;color:#1D7A45}.p-amber{background:var(--amber-s);color:var(--amber-d)}
.p-red{background:var(--clay-s);color:var(--clay)}.p-blue{background:var(--sky-s);color:var(--sky)}
.p-gray{background:#EDEFEA;color:var(--ink2)}.p-pine{background:#DFEAE2;color:var(--pine)}
.gradepill{font-family:var(--mono);font-weight:600;font-size:11px;padding:2px 9px;border-radius:6px}
.gA{background:#E2F1E6;color:#1D7A45}.gB{background:var(--sky-s);color:var(--sky)}.gC{background:var(--amber-s);color:var(--amber-d)}
.gD{background:#F6E3D2;color:#A05A20}.gF{background:var(--clay-s);color:var(--clay)}

/* page head */
.phead{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.phead h2{font-size:21px;font-weight:800;letter-spacing:-.4px}
.phead .psub{color:var(--ink2);font-size:12.5px}
.phead .tools{margin-left:auto;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
select.ctl,input.ctl{padding:8px 11px;border:1.5px solid var(--line2);border-radius:8px;background:#fff;outline:none;transition:all .2s;font-size:13px}
select.ctl:focus,input.ctl:focus{border-color:var(--amber);box-shadow:0 0 0 3px rgba(242,169,59,.2)}
.chip{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1.5px solid var(--line);border-radius:20px;padding:5px 13px;font-size:12px;font-weight:600;transition:all .16s}
.chip:hover{border-color:var(--pine);transform:translateY(-1px)}
.chip.act{background:var(--pine);color:#fff;border-color:var(--pine)}

/* attendance segmented */
.seg{display:inline-flex;border:1.5px solid var(--line2);border-radius:8px;overflow:hidden;background:#fff}
.seg button{border:none;background:none;padding:6px 13px;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--ink2);transition:all .15s;border-right:1px solid var(--line)}
.seg button:last-child{border-right:none}
.seg button:hover{background:#F3F7F1}
.seg button.on-P{background:#1D7A45;color:#fff}.seg button.on-A{background:var(--clay);color:#fff}
.seg button.on-L{background:var(--amber);color:var(--pine3)}.seg button.on-E{background:var(--sky);color:#fff}

/* timetable */
.tt{display:grid;grid-template-columns:74px repeat(5,1fr);gap:8px}
.tt .dh{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;text-align:center;color:var(--ink2);padding:6px 0}
.tt .dh.today{color:var(--pine);font-weight:700;background:#E7F0E6;border-radius:7px}
.tt .time{font-family:var(--mono);font-size:10px;color:var(--ink2);display:flex;align-items:center;justify-content:flex-end;padding-right:8px}
.tt .cell{background:#FAFBF7;border:1px solid var(--line);border-radius:9px;padding:9px 11px;min-height:56px;transition:all .18s;position:relative}
.tt .cell:hover{transform:translateY(-2px);box-shadow:var(--sh);border-color:var(--line2)}
.tt .cell b{font-size:12.5px;display:block}.tt .cell span{font-size:10.5px;color:var(--ink2)}
.tt .cell.now{background:#FFF7E6;border-color:var(--amber);box-shadow:0 0 0 3px rgba(242,169,59,.18)}
.tt .cell.now::after{content:"NOW";position:absolute;top:-8px;right:8px;background:var(--amber);color:var(--pine3);font-family:var(--mono);font-size:8px;font-weight:700;letter-spacing:.1em;padding:2px 7px;border-radius:8px}
.tt .breakrow{grid-column:1/-1;text-align:center;font-family:var(--chalk);font-size:17px;color:var(--ink2);padding:2px 0}

/* books / routes / rooms */
.book{border:1px solid var(--line);border-radius:11px;overflow:hidden;background:#fff;transition:all .2s}
.book:hover{transform:translateY(-4px) rotate(-.4deg);box-shadow:var(--sh2)}
.cover{height:118px;display:flex;align-items:flex-end;padding:12px;position:relative;overflow:hidden}
.cover::after{content:"";position:absolute;left:10px;top:0;bottom:0;width:2px;background:rgba(255,255,255,.4)}
.cover b{font-family:var(--disp);color:#fff;font-size:14px;line-height:1.2;text-shadow:0 1px 4px rgba(0,0,0,.35)}
.route{position:relative;padding-left:26px}
.route::before{content:"";position:absolute;left:8px;top:8px;bottom:8px;width:2px;background:repeating-linear-gradient(var(--pine) 0 6px, transparent 6px 11px)}
.stop{position:relative;padding:5px 0;font-size:12.5px}
.stop::before{content:"";position:absolute;left:-23px;top:10px;width:10px;height:10px;border-radius:50%;background:#fff;border:2.5px solid var(--pine)}
.stop:last-child::before{background:var(--amber);border-color:var(--amber-d)}
.room{border:1.5px solid var(--line);border-radius:10px;padding:12px;background:#fff;transition:all .18s;cursor:pointer}
.room:hover{border-color:var(--pine);transform:translateY(-2px);box-shadow:var(--sh)}
.beds{display:flex;gap:5px;margin-top:8px}
.bed{width:16px;height:22px;border-radius:4px 4px 2px 2px;border:1.5px solid var(--line2);background:#F6F8F3;transition:all .2s}
.bed.occ{background:var(--pine2);border-color:var(--pine)}

/* chat */
.chatwrap{display:grid;grid-template-columns:280px 1fr;height:560px;overflow:hidden}
.thread{display:flex;gap:11px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line);cursor:pointer;transition:background .15s;border-left:3px solid transparent}
.thread:hover{background:#F5F8F2}
.thread.act{background:#F2F7F0;border-left-color:var(--amber)}
.thread b{font-size:13px;display:block}.thread p{font-size:11.5px;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px}
.bubble{max-width:68%;padding:9px 13px;border-radius:12px;font-size:13px;line-height:1.45;animation:pop .25s both}
.bubble.me{background:var(--pine);color:#fff;border-bottom-right-radius:3px;margin-left:auto}
.bubble.them{background:#F0F4EC;border:1px solid var(--line);border-bottom-left-radius:3px}
.bubble time{display:block;font-family:var(--mono);font-size:9px;opacity:.65;margin-top:4px}
.tdot{display:inline-flex;gap:4px;padding:12px 14px}
.tdot span{width:7px;height:7px;border-radius:50%;background:var(--ink2);animation:blink 1.1s infinite}
.tdot span:nth-child(2){animation-delay:.18s}.tdot span:nth-child(3){animation-delay:.36s}

/* announcements */
.ann{display:flex;gap:14px;padding:16px 20px;border-bottom:1px solid var(--line);transition:background .15s}
.ann:hover{background:#FAFBF7}
.ann .aic{width:38px;height:38px;border-radius:9px;background:var(--amber-s);color:var(--amber-d);display:grid;place-items:center;flex:none}
.ann.pinned{background:#FDF8EC}
.ann.pinned:hover{background:#FBF4E0}

/* modal / toast */
.overlay{position:fixed;inset:0;background:rgba(12,42,30,.55);z-index:100;display:grid;place-items:center;padding:20px;animation:fade .2s both}
.modal{background:#fff;border-radius:14px;box-shadow:0 24px 70px rgba(0,0,0,.35);width:min(620px,100%);max-height:88vh;overflow-y:auto;animation:pop .3s cubic-bezier(.2,.9,.3,1.15) both}
.modal.wide{width:min(860px,100%)}
.modal-h{display:flex;align-items:center;gap:12px;padding:18px 22px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:2}
.modal-h h3{font-size:17px;font-weight:800;letter-spacing:-.3px}
.modal-b{padding:20px 22px}
.modal-f{padding:14px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:#fff}
#toasts{position:fixed;bottom:22px;right:22px;z-index:200;display:flex;flex-direction:column;gap:10px}
.toast{display:flex;align-items:center;gap:11px;background:var(--pine3);color:#fff;padding:12px 16px;border-radius:10px;box-shadow:var(--sh2);font-size:13px;font-weight:600;animation:slideIn .35s cubic-bezier(.2,.9,.3,1.2) both;border-left:4px solid var(--amber);max-width:360px}
.toast.err{border-left-color:var(--clay)}.toast.ok{border-left-color:#3FBF7F}
.toast.out{animation:slideOut .3s both}

/* reveal + keyframes */
.rv{opacity:0;transform:translateY(16px);transition:opacity .55s ease, transform .55s cubic-bezier(.2,.8,.3,1)}
.rv.in{opacity:1;transform:none}
@keyframes fade{from{opacity:0}}
@keyframes pop{from{opacity:0;transform:scale(.94) translateY(8px)}}
@keyframes growY{from{transform:scaleY(0)}}
@keyframes growW{from{width:0}}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes ringA{from{stroke-dashoffset:var(--c)}}
@keyframes marq{to{transform:translateX(-50%)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
@keyframes blink{0%,100%{opacity:.25}50%{opacity:1}}
@keyframes slideIn{from{opacity:0;transform:translateX(60px)}}
@keyframes slideOut{to{opacity:0;transform:translateX(60px)}}
@media(max-width:1180px){.span3{grid-column:span 6}.span4,.span5{grid-column:span 6}.span7,.span8{grid-column:span 12}}
@media(max-width:1024px){#app{grid-template-columns:76px 1fr}.side-head b,.side-head span,.navgroup h5,.navitem span,.navitem .cnt,.side-foot{display:none}.navitem{justify-content:center}}
@media(max-width:900px){#login{grid-template-columns:1fr}.board{display:none}.span3,.span4,.span5,.span6{grid-column:span 12}.chatwrap{grid-template-columns:1fr}.topbar{flex-wrap:wrap}.searchbox{min-width:140px}}
