    <div class="fld"><label>Amount (USD)</label><input id="payAmt" type="number" value="${bal}" min="1" max="${bal}"></div>
    <div class="fld"><label>Method</label><select id="payM" class="ctl" style="width:100%"><option>Mobile Money</option><option>Bank Transfer</option><option>Card (Paystack)</option><option>Cash</option><option>Cheque</option></select></div>
    <div class="fld"><label>Reference (optional)</label><input id="payRef" placeholder="e.g. TXN-99213"></div></div>
    <div class="modal-f"><button class="btn btn-ghost" onclick="App.closeModal()">Cancel</button><button class="btn btn-amber" onclick="App.payConfirm('${id}')">Confirm payment →</button></div>`);App._payBal=bal},
  payConfirm(id){const i=db.invoices.find(x=>x.id===id);let amt=+$('#payAmt').value||0;const bal=i.total-i.paid;
