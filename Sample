function sparkSVG(vals,color,w=110,h=34){
  const mx=Math.max(...vals),mn=Math.min(...vals);
  const pts=vals.map((v,i)=>[i*(w-6)/(vals.length-1)+3, h-4-((v-mn)/(mx-mn||1))*(h-10)]);
  const line=pts.map(p=>p.join(',')).join(' ');
  const area=`M${pts[0][0]},${h} L`+pts.map(p=>p.join(',')).join(' L')+` L${pts[pts.length-1][0]},${h} Z`;
  return `<svg width="${w}" height="${h}" class="spark"><path d="${area}" fill="${color}" opacity=".14"/><polyline points="${line}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round"/></svg>`;
}
function barsSVG(data,color='#1C5A3F',h=170){
  const w=Math.max(data.length*34,200),mx=Math.max(...data.map(d=>d.v));
  const bw=18,gap=(w-data.length*bw)/(data.length+1);
  let r='';data.forEach((d,i)=>{const bh=(d.v/mx)*(h-46),x=gap+i*(bw+gap),y=h-26-bh;
    r+=`<rect class="cbar" style="animation-delay:${i*45}ms" x="${x}" y="${y}" width="${bw}" height="${bh}" rx="4" fill="${d.hi?'#F2A93B':color}"><title>${d.l}: ${d.v}</title></rect>
        <text x="${x+bw/2}" y="${h-10}" text-anchor="middle" font-size="9" font-family="IBM Plex Mono" fill="#5C6B5F">${d.l}</text>
        <text x="${x+bw/2}" y="${y-5}" text-anchor="middle" font-size="8.5" font-family="IBM Plex Mono" fill="#152219" font-weight="600">${d.v}</text>`;});
  return `<svg width="100%" viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid meet">${r}</svg>`;
}
function areaSVG(vals,color='#1C5A3F',w=520,h=150){
  const mx=Math.max(...vals)*1.15,mn=0;
  const pts=vals.map((v,i)=>[i*(w-20)/(vals.length-1)+10, h-14-((v-mn)/(mx-mn))*(h-40)]);
  const line=pts.map(p=>p.join(',')).join(' ');
  const area=`M${pts[0][0]},${h-14} L`+pts.map(p=>p.join(',')).join(' L')+` L${pts[pts.length-1][0]},${h-14} Z`;
  let dots='';pts.forEach((p,i)=>dots+=`<circle cx="${p[0]}" cy="${p[1]}" r="3.4" fill="#fff" stroke="${color}" stroke-width="2"><title>Week ${i+1}: ${money(vals[i])}</title></circle>`);
  return `<svg width="100%" viewBox="0 0 ${w} ${h}"><defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${color}" stop-opacity=".28"/><stop offset="1" stop-color="${color}" stop-opacity="0"/></linearGradient></defs><path d="${area}" fill="url(#ag)"/><polyline class="area-line" points="${line}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linecap="round"/>${dots}</svg>`;
}
function donutSVG(segs,size=150,thick=17){
  const r=(size-thick)/2,C=2*Math.PI*r,total=segs.reduce((a,s)=>a+s.v,0);
  let off=0,c='';segs.forEach(s=>{const len=s.v/total*C;
    c+=`<circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${s.c}" stroke-width="${thick}" stroke-dasharray="${len} ${C-len}" stroke-dashoffset="${-off}" transform="rotate(-90 ${size/2} ${size/2})" stroke-linecap="butt"><title>${s.l}: ${s.v}</title></circle>`;off+=len;});
  return `<svg width="${size}" height="${size}"><circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="#EDEFEA" stroke-width="${thick}"/>${c}<text x="50%" y="47%" text-anchor="middle" font-family="Bricolage Grotesque" font-weight="800" font-size="24" fill="#152219">${total}</text><text x="50%" y="62%" text-anchor="middle" font-size="9" font-family="IBM Plex Mono" letter-spacing="1.5" fill="#5C6B5F">INVOICES</text></svg>`;
}
function ringSVG(pct,color='#1C5A3F',size=110,label='ATTEND.'){
  const r=(size-14)/2,C=2*Math.PI*r,off=C*(1-pct/100);
  return `<svg width="${size}" height="${size}"><circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="#EDEFEA" stroke-width="10"/><circle class="ring-fg" style="--c:${C}" cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${color}" stroke-width="10" stroke-linecap="round" stroke-dasharray="${C}" stroke-dashoffset="${off}" transform="rotate(-90 ${size/2} ${size/2})"/><text x="50%" y="48%" text-anchor="middle" font-family="Bricolage Grotesque" font-weight="800" font-size="22" fill="#152219">${pct}%</text><text x="50%" y="64%" text-anchor="middle" font-size="8" font-family="IBM Plex Mono" letter-spacing="1.5" fill="#5C6B5F">${label}</text></svg>`;
}
