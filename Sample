/* ---- TIMETABLE ---- */
Pages.timetable=()=>{
  const cls=st.role==='student'?db.students[0].cls:st.role==='parent'?db.students[1].cls:st.ttCls;
  const cp=curPeriod();
  let grid=`<div class="tt"><div></div>${DAYS.map((d,i)=>`<div class="dh ${i===todayIdx?'today':''}">${d.slice(0,3)}${i===todayIdx?' · TODAY':''}</div>`).join('')}`;
  PERIODS.forEach((p,pi)=>{
    grid+=`<div class="time">P${p.n}<br>${p.s}</div>`;
    for(let d=0;d<5;d++){const c=db.timetable[cls].find(x=>x.day===d&&x.period===p.n);const now=d===todayIdx&&cp===pi;
      grid+=`<div class="cell ${now?'now':''}">${c?`<b>${c.subj}</b><span>${c.teacher}</span>`:'<span>—</span>'}</div>`;}
    if(p.n===3)grid+=`<div class="breakrow">☕ Break · 10:25 – 10:50</div>`;
    if(p.n===5)grid+=`<div class="breakrow">🍲 Lunch · 12:25 – 13:10</div>`;
  });
  return `<div class="phead rv"><div><h2>Class Timetable</h2><div class="psub">Live — the current period is highlighted automatically</div></div>
  <div class="tools">${['admin','teacher'].includes(st.role)?`<select class="ctl" onchange="App.setTtCls(this.value)">${CLASSES.map(c=>`<option ${cls===c?'selected':''}>Class ${c}</option>`).join('')}</select>`:`<span class="chip act">Class ${cls}</span>`}
  <button class="btn btn-ghost btn-sm" onclick="toast('🖨 Timetable sent to printer (demo)')">${icon('print',14)} Print</button></div></div>
  <div class="card rv"><div class="card-b" style="overflow-x:auto">${grid}</div></div>`;
};

