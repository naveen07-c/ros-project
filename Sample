    <div style="flex:1;min-width:160px;border:1.5px solid var(--line);border-radius:10px;padding:14px;text-align:center"><div class="mono" style="font-size:9px;letter-spacing:.2em;color:var(--ink2)">POSITION</div><div class="disp" style="font-size:34px;font-weight:800">#${(100-Math.round(s.ability*100))%28+1}<span style="font-size:15px;color:var(--ink2)">/28</span></div></div></div></div>
    <div class="modal-f"><button class="btn btn-ghost" onclick="App.closeModal()">Close</button><button class="btn btn-pine" onclick="App.printRC('${sid}')">${icon('print',14)} Print report card</button></div>`,true);
