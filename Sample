  const canEdit=st.role==='admin'||st.role==='teacher';
  const students=db.students.filter(s=>s.cls===st.mkCls);
  const subName=SUBJ.find(s=>s.c===st.mkSub)?.n;
  return `<div class="phead rv"><div><h2>Exams & Results</h2><div class="psub">${db.school.term} · grading: A≥85 · B≥70 · C≥55 · D≥40</div></div></div>
  <div class="grid g12" style="grid-template-columns:repeat(3,1fr);margin-bottom:18px">
    ${db.exams.map(e=>`<div class="card rv" style="border-top:4px solid ${e.status==='Completed'?'#1D7A45':e.id==='end'?'#C4502F':'#B97A10'}"><div class="card-b" style="padding:18px 20px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start"><b class="disp" style="font-size:16.5px;font-weight:700;line-height:1.25">${e.name}</b><span class="pill ${e.status==='Completed'?'p-green':'p-amber'}"><i></i>${e.status}</span></div>
      <div class="mono" style="font-size:11px;color:var(--ink2);margin:7px 0 12px">🗓 ${e.dates}</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">${e.published?'<span class="pill p-pine"><i></i>Results published</span>':canEdit&&e.status==='Completed'?`<button class="btn btn-amber btn-sm" onclick="App.publishExam('${e.id}')">Publish results</button>`:''}
      ${canEdit?`<button class="btn btn-ghost btn-sm" onclick="document.getElementById('mkCard').scrollIntoView({behavior:'smooth'})">${icon('edit',13)} Marks</button>`:''}</div></div></div>`).join('')}
  </div>
  ${canEdit?`<div class="card rv" id="mkCard"><div class="card-h"><div><h3>Marks Entry — Mid-Term · ${subName}</h3><div class="sub">Type scores out of 100 — grades compute automatically</div></div>
    <div style="margin-left:auto;display:flex;gap:9px"><select class="ctl" onchange="App.setMkCls(this.value)">${CLASSES.map(c=>`<option ${st.mkCls===c?'selected':''}>Class ${c}</option>`).join('')}</select>
    <select class="ctl" onchange="App.setMkSub(this.value)">${SUBJ.map(s=>`<option value="${s.c}" ${st.mkSub===s.c?'selected':''}>${s.n}</option>`).join('')}</select>
    <button class="btn btn-pine btn-sm" onclick="App.saveMarks()">${icon('check',14)} Save marks</button></div></div>
    <table class="tbl"><thead><tr><th>Student</th><th>Adm No</th><th style="width:130px">Score /100</th><th>Grade</th><th>Remark</th></tr></thead><tbody>
    ${students.map(s=>{const v=db.marks.mid[s.id]?.[st.mkSub]??'';const g=v===''?'—':gradeOf(+v);return `<tr><td><div style="display:flex;gap:10px;align-items:center">${av(s.name)}<b style="font-size:13px">${s.name}</b></div></td><td class="mono" style="font-size:11.5px">${s.adm}</td>
      <td><input class="ctl mk" data-sid="${s.id}" type="number" min="0" max="100" value="${v}" style="width:100px;font-family:var(--mono)" oninput="App.onMark(this)"></td>
      <td><span class="gradepill ${g==='—'?'gC':'g'+g}" id="g-${s.id}">${g}</span></td><td style="font-size:12px;color:var(--ink2)" id="r-${s.id}">${v===''?'Not entered':remarkOf(+v)}</td></tr>`}).join('')}
    </tbody></table></div>`
