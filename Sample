  routeSave(rid){const r=db.routes.find(x=>x.id===rid);r.students=$$('.rt').filter(c=>c.checked).map(c=>c.value);
    save();App.closeModal();refresh();toast(`🚌 ${r.name} updated — ${r.students.length} riders`)},
  roomManage(rid){const r=db.rooms.find(x=>x.id===rid);
    modal(`<div class="modal-h"><h3>Room ${r.name} — ${r.block==='A'?'Boys':'Girls'} Block</h3><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
    <div class="modal-b"><p class="mono" style="font-size:11px;color:var(--ink2);margin-bottom:12px">CAPACITY ${r.cap} · OCCUPIED ${r.students.length}</p>
    <div style="max-height:340px;overflow-y:auto">${db.students.filter(s=>s.gender===(r.block==='A'?'Male':'Female')).map(s=>`<label style="display:flex;gap:11px;align-items:center;padding:8px 4px;border-bottom:1px solid var(--line);cursor:pointer"><input type="checkbox" class="hm" value="${s.id}" ${r.students.includes(s.id)?'checked':''} style="width:16px;height:16px;accent-color:var(--pine)">${av(s.name)}<span style="font-size:13px">${s.name}</span><span class="mono" style="font-size:10.5px;color:var(--ink2);margin-left:auto">${s.cls}</span></label>`).join('')}</div></div>
    <div class="modal-f"><button class="btn btn-ghost" onclick="App.closeModal()">Cancel</button><button class="btn btn-pine" onclick="App.hostelSave('${rid}')">Save allocation</button></div>`)},
  hostelSave(rid){const r=db.rooms.find(x=>x.id===rid);const sel=$$('.hm').filter(c=>c.checked).map(c=>c.value);
    if(sel.length>r.cap)return toast(`Only ${r.cap} beds available in ${r.name}`,'err');
    r.students=sel;save();App.closeModal();refresh();toast(`🛏 Room ${r.name} updated — ${sel.length}/${r.cap} beds occupied`)},

  /* announcements */
  postAnn(){const t=$('#annT').value.trim(),b=$('#annB').value.trim();if(!t||!b)return toast('Title and message are required','err');
    db.announcements.unshift({id:'a'+uid(),title:t,body:b,aud:$('#annA').value,by:ROLES[st.role].n,date:todayISO(),pinned:$('#annP').checked});
    db.notifs.unshift({t:'New announcement: '+t,time:'Just now',read:false});
    db.activity.unshift({t:'Announcement published: '+t,time:'Just now',ic:'mega'});
    save();refresh();toast('📣 Announcement published to <b>'+$('#annA').value+'</b>')},
  togglePin(id){const a=db.announcements.find(x=>x.id===id);a.pinned=!a.pinned;save();renderPage();toast(a.pinned?'📌 Pinned to notice board':'Unpinned')},

  /* messages */
  openThread(i){st.thread=i;st.typing=null;renderPage();const cb=$('#chatBody');if(cb)cb.scrollTop=cb.scrollHeight},
  sendMsg(){const inp=$('#msgIn');const t=inp.value.trim();if(!t)return;
    const th=db.threads[st.thread];const now=new Date();
    th.msgs.push({f:'me',t,time:now.getHours()+':'+String(now.getMinutes()).padStart(2,'0')});
    save();st.typing=st.thread;renderPage();$('#chatBody').scrollTop=$('#chatBody').scrollHeight;
    const replies=['Noted with thanks — I\'ll get back to you shortly.','Received! Let me check and confirm.','Thank you for the message. 👍','Sure, consider it done before close of day.'];
    setTimeout(()=>{th.msgs.push({f:'them',t:replies[Math.floor(Math.random()*replies.length)],time:'now'});st.typing=null;save();if(st.page==='messages')renderPage();toast('💬 Reply from '+th.with)},1800)},

  /* reports */
  repAttendance(){modal(`<div class="modal-h"><h3>Attendance Summary</h3><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
    <div class="modal-b">${barsSVG(db.attHistory.map(d=>({l:d.d.split(' ')[1],v:d.pct})))}<p style="font-size:12.5px;color:var(--ink2);margin-top:8px">Term average: <b>${Math.round(db.attHistory.reduce((a,b)=>a+b.pct,0)/db.attHistory.length)}%</b> · Best day: <b>${Math.max(...db.attHistory.map(d=>d.pct))}%</b> · Lowest: <b>${Math.min(...db.attHistory.map(d=>d.pct))}%</b></p></div>`,true)},
  repExams(){const tops=[...db.students].sort((a,b)=>avgOf(b.id)-avgOf(a.id)).slice(0,5);
    modal(`<div class="modal-h"><h3>Exam Performance — Mid-Term</h3><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
    <div class="modal-b"><b style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)">Subject averages</b><div style="margin:10px 0 18px">${SUBJ.slice(0,7).map(s=>{const vals=db.students.map(x=>db.marks.mid[x.id][s.c]).filter(v=>v!=='');const avg=Math.round(vals.reduce((a,b)=>a+b,0)/vals.length);return hbar(s.c,avg,100,avg>=75?'#1C5A3F':avg>=60?'#B97A10':'#C4502F')}).join('')}</div>
    <b style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)">Top 5 students</b>
    ${tops.map((s,i)=>`<div style="display:flex;gap:12px;align-items:center;padding:9px 0;border-bottom:1px dashed var(--line)"><span class="disp" style="font-weight:800;font-size:16px;width:26px;color:${i<3?'#B97A10':'var(--ink2)'}">${i+1}</span>${av(s.name)}<b style="font-size:13px;flex:1">${s.name} <span class="mono" style="font-size:10px;color:var(--ink2)">· ${s.cls}</span></b><span class="gradepill g${gradeOf(avgOf(s.id))}">${avgOf(s.id)}%</span></div>`).join('')}</div>`,true)},
  repFinance(){const inc=db.invoices.reduce((a,i)=>a+i.paid,0),exp=db.expenses.reduce((a,e)=>a+e.v,0),mx=Math.max(...db.expenses.map(e=>e.v));
    modal(`<div class="modal-h"><h3>Financial Summary — Term 3</h3><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
    <div class="modal-b"><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px">
    ${[['INCOME',inc,'#1D7A45'],['EXPENDITURE',exp,'#C4502F'],['NET SURPLUS',inc-exp,'#123B2A']].map(x=>`<div style="border:1.5px solid var(--line);border-radius:10px;padding:14px;text-align:center"><div class="mono" style="font-size:9px;letter-spacing:.2em;color:var(--ink2)">${x[0]}</div><div class="disp" style="font-size:26px;font-weight:800;color:${x[2]}">${money(x[1])}</div></div>`).join('')}</div>
    ${db.expenses.map(e=>hbar(e.c.slice(0,10),e.v,mx,'#B97A10')).join('')}</div>`,true)},
  repCensus(){modal(`<div class="modal-h"><h3>School Census</h3><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
    <div class="modal-b"><b style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)">Enrollment by class</b><div style="margin:10px 0 18px">${CLASSES.map(c=>hbar(c,db.students.filter(s=>s.cls===c).length,Math.max(...CLASSES.map(c=>db.students.filter(s=>s.cls===c).length)),'#1C5A3F')).join('')}</div>
    <div style="display:flex;gap:14px;flex-wrap:wrap">${[['Girls',db.students.filter(s=>s.gender==='Female').length,'#BE185D'],['Boys',db.students.filter(s=>s.gender==='Male').length,'#2F6FA3'],['Boarders',db.rooms.reduce((a,r)=>a+r.students.length,0),'#B97A10'],['Bus riders',db.routes.reduce((a,r)=>a+r.students.length,0),'#123B2A']].map(x=>`<div style="flex:1;min-width:130px;border:1.5px solid var(--line);border-radius:10px;padding:14px;text-align:center"><div class="mono" style="font-size:9px;letter-spacing:.2em;color:var(--ink2)">${x[0].toUpperCase()}</div><div class="disp" style="font-size:28px;font-weight:800;color:${x[2]}">${x[1]}</div></div>`).join('')}</div></div>`,true)},

  /* settings */
  saveSettings(){db.school.name=$('#setName').value;db.school.phone=$('#setPhone').value;db.school.email=$('#setEmail').value;db.school.address=$('#setAddr').value;
    save();$('#sideName').textContent=db.school.name;toast('⚙ School profile saved')},
  togglePerm(r,m){const arr=db.perms[r];const i=arr.indexOf(m);if(i>=0){if(m==='dashboard')return;arr.splice(i,1)}else arr.push(m);
    save();renderNav();toast(`🔐 ${m} ${i>=0?'revoked from':'granted to'} ${r}`)},
  resetData(){localStorage.removeItem(DBK);db=seed();save();refresh();toast('♻ Demo data restored to factory seed','err')}
};

/* ═════════════ INIT ═════════════ */
function tick(){const d=new Date();const el=$('#clk');if(el)el.textContent=d.toLocaleTimeString('en-GB');setTimeout(tick,1000)}
tick();
const tickTxt=['📌 Term 3 begins Tue 21 July','🗓 Science Fair — Jul 24','🚌 Route 3 departs 06:15','🏆 Athletics trials Friday','📚 Library open 08:00–16:30','💳 Fees due Jul 31'].join('<span>◆</span>');
$('#loginTick').innerHTML='<span>'+tickTxt+'</span><span>'+tickTxt+'</span>';
document.addEventListener('keydown',e=>{if(e.key==='Escape')App.closeModal()});
</script>
</body>
