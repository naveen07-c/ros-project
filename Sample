    modal(`<div class="modal-h"><h3>Report Card — ${s.name}</h3><span class="mono" style="font-size:10.5px;color:var(--ink2)">MID-TERM · ${db.school.term}</span><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
