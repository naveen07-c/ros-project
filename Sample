};

/* ---- FEES ---- */
Pages.fees=()=>{
  const collected=db.invoices.reduce((a,i)=>a+i.paid,0),outstanding=db.invoices.reduce((a,i)=>a+i.total-i.paid,0),overdue=db.invoices.filter(i=>i.status==='Overdue');
  let list=db.invoices;
  if(st.role==='parent')list=[invOf(db.students[1].id),invOf(db.students[6].id)];
  if(st.role==='student')list=[invOf(db.students[0].id)];
  if(st.feeF!=='All')list=list.filter(i=>i.status===st.feeF);
  if(st.q)list=list.filter(i=>{const s=S(i.sid);return (s.name+i.title).toLowerCase().includes(st.q.toLowerCase())});
  const canPay=st.role!=='teacher';
  return `<div class="phead rv"><div><h2>Fees & Payments</h2><div class="psub">Term 3 · due 31 July 2026 · online, bank & mobile money accepted</div></div>
    <div class="tools">${st.role==='admin'?`<select class="ctl" onchange="App.setFeeF(this.value)">${['All','Paid','Partial','Overdue'].map(c=>`<option ${st.feeF===c?'selected':''}>${c}</option>`).join('')}</select>
    <button class="btn btn-ghost btn-sm" onclick="App.exportFees()">${icon('dl',14)} Export CSV</button>`:''}</div></div>
  <div class="grid g12" style="margin-bottom:18px">
    ${[['COLLECTED THIS TERM',collected,'$','#1D7A45','▲ 12% vs Term 2','d-up'],['OUTSTANDING',outstanding,'$','#B97A10',Math.round(outstanding/(collected+outstanding)*100)+'% of billed','d-fl'],['OVERDUE INVOICES',overdue.length,'','#C4502F',money(overdue.reduce((a,i)=>a+i.total-i.paid,0))+' at risk','d-dn'],['REVENUE · 8 WEEKS',db.revenue.reduce((a,b)=>a+b,0),'$','#123B2A','Best week: '+money(Math.max(...db.revenue)),'d-up']]
    .map(s=>`<div class="card stat span3 rv" style="--sc:${s[3]}"><div class="lbl">${s[0]}</div><div class="num" data-count="${s[1]}" data-pre="${s[2]}">0</div><span class="delta ${s[5]}">${s[4]}</span></div>`).join('')}
  </div>
  ${st.role==='admin'?`<div class="card rv" style="margin-bottom:18px"><div class="card-h"><h3>Weekly Collections</h3><span class="sub" style="margin-left:auto">Fees + other income</span></div><div class="card-b">${areaSVG(db.revenue)}</div></div>`:''}
  <div class="card rv" style="overflow-x:auto"><div class="card-h"><h3>Invoices</h3><span class="mono" style="margin-left:auto;font-size:11px;color:var(--ink2)">${list.length} shown</span></div>
  <table class="tbl"><thead><tr><th>Student</th><th>Invoice</th><th>Due</th><th style="text-align:right">Total</th><th style="text-align:right">Paid</th><th style="text-align:right">Balance</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>
  ${list.map(i=>{const s=S(i.sid);const bal=i.total-i.paid;return `<tr><td><div style="display:flex;gap:10px;align-items:center">${av(s.name)}<div><b style="font-size:13px">${s.name}</b><div class="mono" style="font-size:10px;color:var(--ink2)">${s.cls} · ${s.adm}</div></div></div></td>
    <td style="font-size:12.5px">${i.title}</td><td class="mono" style="font-size:11.5px;color:${i.status==='Overdue'?'var(--clay)':'var(--ink2)'}">${fdate(i.due)}</td>
    <td class="mono" style="text-align:right">${money(i.total)}</td><td class="mono" style="text-align:right;color:#1D7A45">${money(i.paid)}</td><td class="mono" style="text-align:right;font-weight:600">${money(bal)}</td>
    <td><span class="pill ${i.status==='Paid'?'p-green':i.status==='Partial'?'p-amber':'p-red'}"><i></i>${i.status}</span></td>
    <td style="text-align:right;white-space:nowrap">${bal>0&&canPay?`<button class="btn btn-amber btn-sm" onclick="App.payOpen('${i.id}')">Pay</button> `:''}<button class="btn btn-ghost btn-sm" onclick="App.receipt('${i.id}')">${icon('print',13)}</button></td></tr>`}).join('')}
  </tbody></table></div>`;
};

/* ---- LIBRARY ---- */
Pages.library=()=>{
  let books=db.books;if(st.q)books=books.filter(b=>(b.title+b.author).toLowerCase().includes(st.q.toLowerCase()));
  const issued=db.loans.length, over=db.loans.filter(l=>l.due<todayISO()).length;
  const isAdmin=st.role==='admin';
  return `<div class="phead rv"><div><h2>Library</h2><div class="psub">${db.books.reduce((a,b)=>a+b.qty,0)} volumes · ${issued} on loan · ${over} overdue · fine $0.50/day</div></div></div>
  <div class="grid g12" style="margin-bottom:18px">
    ${[['TOTAL TITLES',db.books.length,'','#1C5A3F'],['COPIES IN CATALOGUE',db.books.reduce((a,b)=>a+b.qty,0),'','#2F6FA3'],['ON LOAN',issued,'','#B97A10'],['OVERDUE',over,'','#C4502F']].map(s=>`<div class="card stat span3 rv" style="--sc:${s[3]}"><div class="lbl">${s[0]}</div><div class="num" data-count="${s[1]}" data-pre="${s[2]}">0</div></div>`).join('')}
  </div>
  <div class="grid g12" style="grid-template-columns:repeat(auto-fill,minmax(190px,1fr));margin-bottom:20px">
  ${books.map(b=>`<div class="book rv"><div class="cover" style="background:linear-gradient(150deg,${b.color},${b.color}CC)"><b>${b.title}</b></div>
    <div style="padding:12px 14px"><div style="font-size:11.5px;color:var(--ink2)">${b.author}</div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0"><span class="mono" style="font-size:10px;color:var(--ink2)">${b.cat} · ${b.shelf}</span><span class="pill ${b.avail?'p-green':'p-red'}"><i></i>${b.avail}/${b.qty} in</span></div>
    ${isAdmin?`<button class="btn btn-pine btn-sm btn-block" style="justify-content:center" ${!b.avail?'disabled style="opacity:.45;justify-content:center"':''} onclick="App.issueOpen('${b.id}')">${b.avail?'Issue book':'All out'}</button>`:''}</div></div>`).join('')}
  </div>
  ${isAdmin?`<div class="card rv" style="overflow-x:auto"><div class="card-h"><h3>Active Loans</h3></div><table class="tbl"><thead><tr><th>Book</th><th>Borrower</th><th>Issued</th><th>Due</th><th>Fine</th><th style="text-align:right">Action</th></tr></thead><tbody>
  ${db.loans.map(l=>{const b=db.books[l.bid],s=S(l.sid);const days=Math.max(0,Math.floor((new Date(todayISO())-new Date(l.due))/86400000));return `<tr><td><b style="font-size:13px">${b.title}</b></td><td><div style="display:flex;gap:9px;align-items:center">${av(s.name)}<span style="font-size:12.5px">${s.name} <span class="mono" style="font-size:10px;color:var(--ink2)">· ${s.cls}</span></span></div></td><td class="mono" style="font-size:11.5px">${fdate(l.out)}</td><td class="mono" style="font-size:11.5px;color:${days?'var(--clay)':'var(--ink2)'}">${fdate(l.due)}</td><td class="mono" style="font-weight:600;color:${days?'var(--clay)':'#1D7A45'}">${days?money(days*.5):'—'}</td><td style="text-align:right"><button class="btn btn-ghost btn-sm" onclick="App.returnBook('${l.id}')">Return${days?' · collect '+money(days*.5):''}</button></td></tr>`}).join('')}
  </tbody></table></div>`:''}`;
};

