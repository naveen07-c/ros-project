      <div style="border:1.5px solid var(--line);border-radius:10px;padding:13px;text-align:center"><div class="mono" style="font-size:9px;letter-spacing:.2em;color:var(--ink2)">MID-TERM AVG</div><div class="disp" style="font-size:32px;font-weight:800">${avg}%</div><span class="gradepill g${gradeOf(avg)}">${gradeOf(avg)}</span></div>
      <div style="border:1.5px solid var(--line);border-radius:10px;padding:13px;text-align:center"><div class="mono" style="font-size:9px;letter-spacing:.2em;color:var(--ink2)">FEES OWING</div><div class="disp" style="font-size:32px;font-weight:800;color:${inv.total-inv.paid?'#C4502F':'#1D7A45'}">${money(inv.total-inv.paid)}</div><span class="pill ${inv.status==='Paid'?'p-green':inv.status==='Partial'?'p-amber':'p-red'}"><i></i>${inv.status}</span></div></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px"><div><b style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)">Guardian</b><p style="font-size:13px;margin-top:5px">${s.guardian}<br><span class="mono" style="font-size:11.5px;color:var(--ink2)">${s.phone}</span></p>
    <b style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);display:block;margin-top:14px">Date of birth</b><p class="mono" style="font-size:12.5px;margin-top:5px">${fdate(s.dob)}</p></div>
    <div><b style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)">Subject snapshot</b><div style="margin-top:8px">${SUBJ.slice(0,5).map(x=>hbar(x.c,m[x.c]||0,100,'#1C5A3F')).join('')}</div></div></div></div>
    <div class="modal-f"><button class="btn btn-ghost" onclick="App.closeModal()">Close</button><button class="btn btn-pine" onclick="App.openRC('${s.id}')">${icon('doc',14)} Report card</button></div>`,true)},
  exportStudents(){downloadCSV('students_'+todayISO()+'.csv',[['Admission No','Name','Class','Gender','Guardian','Phone','Attendance %','Mid-Term Avg','Status'],...db.students.map(s=>[s.adm,s.name,s.cls,s.gender,s.guardian,s.phone,Math.round(s.attPct*100),avgOf(s.id),s.status])])},
  openRC(sid){const s=S(sid),m=db.marks.mid[sid]||{},avg=avgOf(sid);
    const rows=SUBJ.map(x=>{const v=m[x.c]??0;const g=v===''?'—':gradeOf(+v);return `<tr><td><b>${x.n}</b></td><td class="mono">${x.c}</td><td class="mono">${v}</td><td><span class="pill g${g}" style="background:none">${g}</span></td><td class="mono">${v===''?'—':ptsOf(g)}</td><td style="color:#5C6B5F;font-size:12px">${v===''?'Not assessed':remarkOf(+v)}</td></tr>`}).join('');
    const body=`<table><tr><th>Subject</th><th>Code</th><th>Score /100</th><th>Grade</th><th>Points</th><th>Remarks</th></tr>${rows}
      <tr style="background:#EFF2E9;font-weight:700"><td colspan="2">OVERALL</td><td class="mono">${avg}%</td><td>${gradeOf(avg)}</td><td class="mono">GPA ${ptsOf(gradeOf(avg)).toFixed(1)}</td><td>${remarkOf(avg)}</td></tr></table>
      <p style="margin-top:14px;font-size:12px"><b>Attendance:</b> ${Math.round(s.attPct*100)}% &nbsp;·&nbsp; <b>Class:</b> ${s.cls} &nbsp;·&nbsp; <b>Class position:</b> #${(100-Math.round(s.ability*100))%28+1} of 28</p>
