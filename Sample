  exportFees(){downloadCSV('fees_'+todayISO()+'.csv',[['Student','Class','Invoice','Total','Paid','Balance','Status','Due'],...db.invoices.map(i=>{const s=S(i.sid);return [s.name,s.cls,i.title,i.total,i.paid,i.total-i.paid,i.status,i.due]})])},

  /* library */
  issueOpen(bid){const b=db.books.find(x=>x.id===bid);
    modal(`<div class="modal-h"><h3>Issue — ${esc(b.title)}</h3><button class="iconbtn" style="margin-left:auto" onclick="App.closeModal()">${icon('x',15)}</button></div>
