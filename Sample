    <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap"><div style="flex:1;min-width:160px;border:1.5px solid var(--line);border-radius:10px;padding:14px;text-align:center"><div class="mono" style="font-size:9px;letter-spacing:.2em;color:var(--ink2)">AVERAGE</div><div class="disp" style="font-size:34px;font-weight:800">${avg}%</div></div>
