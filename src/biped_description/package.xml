<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>biped_description</name>
  <version>0.1.0</version>
  <description>URDF/Xacro description of the bipedal payload-carrying robot (10 DoF: hip roll+pitch, knee pitch, ankle pitch+roll per leg).</description>
  <maintainer email="student@example.com">sudeep</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- URDF embeds the gz_ros2_control plugin tag with the controllers YAML
       resolved from biped_control (M5) -->
  <exec_depend>biped_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
