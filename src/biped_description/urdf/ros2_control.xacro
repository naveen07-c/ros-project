<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       ros2_control integration for Gazebo (gz_ros2_control, Jazzy).

       Command interfaces: POSITION on all 10 joints. The GazeboSimSystem
       plugin realizes position commands through an internal proportional
       law (position_proportional_gain), so no per-joint PID is needed
       in simulation. Position control matches the joint-space trajectory
       goals planned for the gait generator (PROJECT_REQUIREMENTS §5, C2).

       hold_joints=true: joints hold their position until a controller
       claims them -> the robot stands straight at spawn without any
       controller running. Values below are ASSUMPTIONS (§12) pending M5
       tuning.
       ============================================================ -->

  <xacro:macro name="ros2_control_gazebo" params="controllers_file">

    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <!-- M8: the JTC now runs in EFFORT mode (per-joint PID in
           biped_controllers.yaml). The position interface stays declared
           so gz_ros2_control's hold_joints can freeze the spawn pose
           before a controller activates (its internal position law uses
           it); the effort interface is what the JTC claims. -->
      <joint name="left_hip_roll">
        <command_interface name="position">
          <param name="min">${-hip_roll_lim_deg*pi/180.0}</param>
          <param name="max">${hip_roll_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_hip_pitch">
        <command_interface name="position">
          <param name="min">${-hip_pitch_lim_deg*pi/180.0}</param>
          <param name="max">${hip_pitch_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_knee">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">${knee_pitch_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_ankle_pitch">
        <command_interface name="position">
          <param name="min">${-ankle_pitch_lim_deg*pi/180.0}</param>
          <param name="max">${ankle_pitch_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_ankle_roll">
        <command_interface name="position">
          <param name="min">${-ankle_roll_lim_deg*pi/180.0}</param>
          <param name="max">${ankle_roll_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="right_hip_roll">
        <command_interface name="position">
          <param name="min">${-hip_roll_lim_deg*pi/180.0}</param>
          <param name="max">${hip_roll_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_hip_pitch">
        <command_interface name="position">
          <param name="min">${-hip_pitch_lim_deg*pi/180.0}</param>
          <param name="max">${hip_pitch_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_knee">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">${knee_pitch_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_ankle_pitch">
        <command_interface name="position">
          <param name="min">${-ankle_pitch_lim_deg*pi/180.0}</param>
          <param name="max">${ankle_pitch_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_ankle_roll">
        <command_interface name="position">
          <param name="min">${-ankle_roll_lim_deg*pi/180.0}</param>
          <param name="max">${ankle_roll_lim_deg*pi/180.0}</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">${-joint_eff_lim}</param>
          <param name="max">${joint_eff_lim}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
        <hold_joints>true</hold_joints>
        <!-- Only used for the pre-activation hold_joints freeze (the JTC
             itself now claims the effort interfaces; see above). -->
        <position_proportional_gain>1.0</position_proportional_gain>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
