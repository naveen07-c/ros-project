<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       M8 sensors (PROJECT_REQUIREMENTS §6):
         - IMU on the pelvis (base_link): body orientation input for
           odometry pitch and later ZMP/CoM estimation.
         - One contact sensor per foot: stance/swing detection for the
           gait odometry (replaces the planned /gait_support stance
           source, the documented M6 gap).

       Simulated with Gazebo Harmonic sensor systems (world plugins in
       flat_world.sdf) and bridged to ROS in gazebo.launch.py:
         /imu               sensor_msgs/Imu            gz.msgs.IMU
         /<side>_foot_contact  ros_gz_interfaces/Contacts  gz.msgs.Contacts

       Sensor poses are identity in their link frame; rates are
       ASSUMPTIONS (§6 lists no rates). No noise is modeled yet - the
       acceptance test (AT-08) checks rates/frames, not noise realism.
       ============================================================ -->

  <xacro:property name="imu_rate_hz" value="100"/>
  <xacro:property name="contact_rate_hz" value="200"/>

  <xacro:macro name="imu_sensor" params="imu_topic">
    <gazebo reference="base_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>${imu_rate_hz}</update_rate>
        <visualize>false</visualize>
        <topic>${imu_topic}</topic>
        <!-- Identity pose: IMU frame == base_link frame -->
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="foot_contact_sensor" params="prefix contact_topic">
    <gazebo reference="${prefix}_foot">
      <sensor name="${prefix}_foot_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>${contact_rate_hz}</update_rate>
        <visualize>false</visualize>
        <topic>${contact_topic}</topic>
        <contact>
          <!-- Local collision name of the sole (leg.xacro) -->
          <collision>${prefix}_foot_collision</collision>
          <!-- The topic must ALSO live here: gz-sim's Contact system
               reads the topic from the <contact> element, and the URDF
               converter overwrites a missing one with
               __default_topic__ (-> world-scoped topic, unreachable
               from the bridge). Found the hard way in M8 testing. -->
          <topic>${contact_topic}</topic>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
