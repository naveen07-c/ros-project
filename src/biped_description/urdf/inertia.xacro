<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Inertial macro.
       NOTE: All numeric values below are ASSUMPTIONS from
       PROJECT_REQUIREMENTS.md. They are NOT confirmed specifications.
       Density is an illustrative aluminium-ish value pending real CAD.
       box_inertial: origin is the box center offset from the link frame.
       ============================================================ -->

  <xacro:property name="alu_density" value="2700.0"/>

  <xacro:macro name="box_inertial" params="m x y z ox:=0 oy:=0 oz:=0">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="${ox} ${oy} ${oz}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

</robot>
