<?xml version="1" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================================================
       M12 Tier S (HARDWARE_SELECTION.md §7): ros2_control block for
       the real ₹15,000 PWM-servo build. Loaded INSTEAD of
       ros2_control.xacro's gazebo macro by the hardware launch; the
       bringup/URDF rescale itself is M13 work.

       - Same 10 joint names as the simulation block, so the controllers
         YAML and every node stay byte-identical.
       - Command: POSITION only (the DS3218's internal loop IS the plant;
         the sim's effort-mode PID has no hardware analog — documented
         accepted loss).
       - Per-joint servo calibration as ros2_control params, consumed by
         pwm_servo_hw (channel on the PCA9685, neutral pulse, scale,
         sign). us_per_rad = 1000 us / 150 deg ≈ 6.7 us/deg ≈ 382 us/rad;
         hips/knees use the 180 deg DS3218 variant spec'd in the BOM.
       - State: position is the last commanded value (PWM servos have no
         readback), effort is always 0 — see pwm_servo_hw.cpp.
       ============================================================ -->

  <xacro:macro name="ros2_control_hardware" params="serial_device:=/dev/ttyUSB0">

    <ros2_control name="PwmServoSystem" type="system">
      <hardware>
        <plugin>biped_control/PwmServoHardware</plugin>
        <parameter name="serial_device">${serial_device}</parameter>
      </hardware>

      <!-- xacro:macro for one joint's interface set -->
      <xacro:macro name="pwm_joint" params="name chan center:='1500' usr:='382.0' dir:='1'">
        <joint name="${name}">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <parameter name="channel">${chan}</parameter>
          <parameter name="center_us">${center}</parameter>
          <parameter name="us_per_rad">${usr}</parameter>
          <parameter name="dir">${dir}</parameter>
        </joint>
      </xacro:macro>

      <xacro:pwm_joint name="left_hip_roll"   chan="0"/>
      <xacro:pwm_joint name="left_hip_pitch"  chan="1"/>
      <xacro:pwm_joint name="left_knee"       chan="2"/>
      <xacro:pwm_joint name="left_ankle_pitch" chan="3"/>
      <xacro:pwm_joint name="left_ankle_roll" chan="4"/>
      <xacro:pwm_joint name="right_hip_roll"  chan="5"/>
      <xacro:pwm_joint name="right_hip_pitch" chan="6"/>
      <xacro:pwm_joint name="right_knee"      chan="7"/>
      <xacro:pwm_joint name="right_ankle_pitch" chan="8"/>
      <xacro:pwm_joint name="right_ankle_roll" chan="9"/>
    </ros2_control>

  </xacro:macro>

</robot>
