<?xml version="1.0"?>
<!--
  Top-level robot description: bipedal payload robot (10 DoF).

  Every geometric/mass number here is an ASSUMPTION recorded in
  PROJECT_REQUIREMENTS.md (§3/§4) - not a confirmed specification.
  Dimensions live as xacro properties in the included files.
-->
<robot name="biped_payload_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="with_payload" default="true"/>
  <xacro:property name="with_payload" value="$(arg with_payload)"/>

  <!-- Appearance from Robot.STEP; all simulation parameters stay original. -->
  <xacro:include filename="cad_visuals.xacro"/>

  <xacro:include filename="inertia.xacro"/>
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="leg.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>

  <!-- Hip lateral separation (ASSUMPTION, PROJECT_REQUIREMENTS §3;
       Robot.png comparison reads ~0.20 m) -->
  <xacro:property name="hip_y" value="0.10"/>

  <!-- Controllers YAML consumed by the gz_ros2_control plugin (M5). -->
  <xacro:property name="controllers_file"
                  value="$(find biped_control)/config/biped_controllers.yaml"/>

  <xacro:base with_payload="$(arg with_payload)"/>

  <xacro:leg prefix="left" hip_y="${hip_y}"/>
  <xacro:leg prefix="right" hip_y="${-hip_y}"/>

  <!-- M8 sensors (PROJECT_REQUIREMENTS §6): pelvis IMU + foot contacts.
       Topics match the ros_gz_bridge config in gazebo.launch.py. -->
  <xacro:imu_sensor imu_topic="/imu"/>
  <xacro:foot_contact_sensor prefix="left" contact_topic="/left_foot_contact"/>
  <xacro:foot_contact_sensor prefix="right" contact_topic="/right_foot_contact"/>

  <xacro:ros2_control_gazebo controllers_file="${controllers_file}"/>

</robot>
