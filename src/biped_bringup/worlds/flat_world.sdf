<?xml version="1.0"?>
<!--
  Flat ground world for the biped (M3/M4). Ground plane and sun are
  inline (no Fuel/model:// includes) so the world loads offline.
-->
<sdf version="1.10">
  <world name="flat">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- AT-11 run BP: the explicit <dart> block (PGS/bullet variants,
           runs Q-BN) coincides EXACTLY with the era where the APPROACH
           crouch could no longer complete (0 steps built since BB).
           Removed to restore run-I default physics; per-element
           re-addition will identify the poison if needed. -->
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- M8 (PROJECT_REQUIREMENTS §6): sensor systems so the URDF-declared
         IMU and foot-contact sensors are simulated and published on their
         gz transport topics (bridged to ROS in gazebo.launch.py). The
         rendering-backed Sensors system is not needed (no camera/lidar). -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8066</gravity>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
